    <diagram name="2 hc_pre 细节" id="dg-24379767">
        <mxGraphModel dx="2133" dy="1885" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" value="hc_pre：一次前向的完整算术（张量形状按 hidden_size=3、hc_mult=4、num_tokens=2 标注）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f3864;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1560" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="x&lt;br&gt;(num_tokens, hc_mult, hidden_size)&lt;br&gt;= (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="76" width="250" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="x_flat = x.flatten(1)&lt;br&gt;(num_tokens, hc_mult * hidden_size)&lt;br&gt;= (2, 12)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="350" y="76" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="InvRMS 归一化&lt;br&gt;rsqrt = 1 / sqrt(mean(x²) + norm_eps)&lt;br&gt;(num_tokens, 1) = (2, 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="700" y="76" width="330" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="mixes = x_flat @ hc_fn.T&lt;br&gt;(num_tokens, mix_hc) = (2, 24)&lt;br&gt;mix_hc = (2 + hc_mult) * hc_mult = 24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="76" width="400" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="pre_mixes&lt;br&gt;(num_tokens, hc_mult) = (2, 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="200" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="comb_mixes&lt;br&gt;(num_tokens, hc_mult*hc_mult) = (2, 16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="510" y="200" width="420" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="post_mixes&lt;br&gt;(num_tokens, hc_mult) = (2, 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="200" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n2" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n3" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n4" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n5" target="n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n5" target="n7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n5" target="n8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="pre = sigmoid(mixes[0:4] * rsqrt * hc_scale[0] + hc_base[0:hc_mult]) + hc_eps&lt;br&gt;&lt;br&gt;1. pre_tmp1   = pre_mixes * rsqrt                # 乘 rsqrt，行归一化&lt;br&gt;2. pre_tmp2   = pre_tmp1 * hc_scale[0]           # 乘 scale，标量缩放&lt;br&gt;3. pre_logits = pre_tmp2 + hc_base[0:hc_mult]    # 加 base，加偏置&lt;br&gt;4. pre_sigmoid = sigmoid(pre_logits)             # sigmoid 激活&lt;br&gt;5. pre_gate    = pre_sigmoid + hc_eps            # 加 eps，避免为 0&lt;br&gt;   shape: (num_tokens, hc_mult) = (2, 4)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="280" width="430" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="post = 2 * sigmoid(mixes[20:24] * rsqrt * hc_scale[1] + hc_base[hc_mult:2*hc_mult])&lt;br&gt;&lt;br&gt;1. post_tmp1   = post_mixes * rsqrt                 # 乘 rsqrt&lt;br&gt;2. post_tmp2   = post_tmp1 * hc_scale[1]            # 乘 scale&lt;br&gt;3. post_logits = post_tmp2 + hc_base[hc_mult:2*hc_mult]  # 加 base&lt;br&gt;4. post_sigmoid = sigmoid(post_logits)              # sigmoid&lt;br&gt;5. post        = post_sigmoid * 2.0                 # 乘 2，落到 (0, 2)&lt;br&gt;   shape: (num_tokens, hc_mult) = (2, 4)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="280" width="430" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="comb = Sinkhorn(softmax(mixes[4:20] * rsqrt * hc_scale[2] + hc_base[2*hc_mult:2*hc_mult+hc_mult*hc_mult]))&lt;br&gt;&lt;br&gt;# 第1阶段：logits 计算 + reshape&lt;br&gt;comb_tmp1   = comb_mixes * rsqrt                     # 乘 rsqrt&lt;br&gt;comb_tmp2   = comb_tmp1 * hc_scale[2]                # 乘 scale&lt;br&gt;comb_logits = comb_tmp2 + hc_base[2*hc_mult : 2*hc_mult + hc_mult*hc_mult]&lt;br&gt;P0 = comb_logits.reshape(num_tokens, hc_mult, hc_mult)   # (2, 16) -&gt; (2, 4, 4)&lt;br&gt;&lt;br&gt;# 第2阶段：初始 softmax（行归一化）&lt;br&gt;row_max     = P0.max(dim=-1, keepdim=True).values&lt;br&gt;P_minus_max = P0 - row_max                            # 减行最大值，防 exp 溢出&lt;br&gt;P_exp       = P_minus_max.exp()&lt;br&gt;row_sum     = P_exp.sum(dim=-1, keepdim=True)&lt;br&gt;P           = P_exp / (row_sum + hc_eps)              # 行和为 1&lt;br&gt;&lt;br&gt;# 第3阶段：初始列归一化&lt;br&gt;col_sum = P.sum(dim=-2, keepdim=True)                 # (num_tokens, 1, hc_mult)&lt;br&gt;P       = P / (col_sum + hc_eps)                      # 列和为 1&lt;br&gt;&lt;br&gt;# 第4阶段：Sinkhorn 迭代（hc_sinkhorn_iters - 1 次，共 20 轮）&lt;br&gt;for t = 1 to hc_sinkhorn_iters-1:&lt;br&gt;    row_sum = P.sum(dim=-1, keepdim=True)             # (num_tokens, hc_mult, 1)&lt;br&gt;    P       = P / (row_sum + hc_eps)                  # 行归一化&lt;br&gt;    col_sum = P.sum(dim=-2, keepdim=True)             # (num_tokens, 1, hc_mult)&lt;br&gt;    P       = P / (col_sum + hc_eps)                  # 列归一化" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="510" y="280" width="520" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n6" target="n15" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n7" target="n17" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n8" target="n16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n21" value="pre_gate&lt;br&gt;(num_tokens, hc_mult) = (2, 4)&lt;br&gt;值域 (eps, 1+eps)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="300" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="n22" value="post&lt;br&gt;(num_tokens, hc_mult) = (2, 4)&lt;br&gt;值域 (0, 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="510" width="300" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="n23" value="# 第5阶段：最终结果&lt;br&gt;comb_frag = P&lt;br&gt;(num_tokens, hc_mult, hc_mult) = (2, 4, 4)&lt;br&gt;行和 = 1 且 列和 = 1（双随机）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="510" y="760" width="460" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n15" target="n21" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n16" target="n22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n17" target="n23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n27" value="x_float = x.to(torch.float32)&lt;br&gt;(num_tokens, hc_mult, hidden_size)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n28" value="x_gated = x_float * pre_gate.unsqueeze(-1)&lt;br&gt;按通道加权：pre_gate 广播到 hidden_size 维&lt;br&gt;(num_tokens, hc_mult, hidden_size) = (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="696" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="n29" value="y_float = x_gated.sum(dim=1)&lt;br&gt;(num_tokens, hidden_size) = (2, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="802" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n30" value="y = y_float.to(torch.bfloat16)&lt;br&gt;(num_tokens, hidden_size) = (2, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="888" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n21" target="n28" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n27" target="n28" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n28" target="n29" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n29" target="n30" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n35" value="门控列区间（mix_hc = 24）：&lt;br&gt;[0, 4)    → pre  的 4 个 logits&lt;br&gt;[4, 20)   → comb 的 16 个 logits&lt;br&gt;[20, 24)  → post 的 4 个 logits&lt;br&gt;&lt;br&gt;注意：rsqrt 作用于整个 hc_mult * hidden_size 维，&lt;br&gt;不是单条流；pre 是 sigmoid + eps，4 个权重之和不为 1。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="610" width="430" height="160" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="3 hc_post 细节" id="dg-28450641">
        <mxGraphModel dx="1706" dy="1508" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" value="hc_post：深度混合 + 门控写回（einsum 的语义）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f3864;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1340" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="residual&lt;br&gt;(num_tokens, hc_mult, hidden_size) = (2, 4, 3)&lt;br&gt;未压缩的 4 条流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="100" width="280" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="comb&lt;br&gt;(num_tokens, hc_mult, hc_mult) = (2, 4, 4)&lt;br&gt;双随机矩阵，comb[b, i, j] 表示：&lt;br&gt;第 i 个输入通道 对 第 j 个输出通道 的权重" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="220" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="residual_mixed = einsum('b i h, b i j -&gt; b j h', residual, comb)&lt;br&gt;&lt;br&gt;对第 j 个输出通道的第 h 个值：&lt;br&gt;把「所有输入通道的第 h 个值」分别乘以&lt;br&gt;「该输入通道对第 j 个输出通道的权重」，再求和。&lt;br&gt;&lt;br&gt;shape: (num_tokens, hc_mult, hidden_size) = (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Courier New;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="400" y="120" width="480" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="residual_mixed&lt;br&gt;(2, 4, 3)&lt;br&gt;深度混合后的 4 条流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="940" y="150" width="260" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n2" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n3" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="einsum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n4" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="x&lt;br&gt;(num_tokens, 1, hidden_size) = (2, 1, 3)&lt;br&gt;子层输出，unsqueeze(1) 后" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="400" width="280" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="post.unsqueeze(-1)&lt;br&gt;(num_tokens, hc_mult, 1) = (2, 4, 1)&lt;br&gt;每条流的写入强度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="510" width="280" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="x_gated = x.unsqueeze(1) * post.unsqueeze(-1)&lt;br&gt;广播成 (num_tokens, hc_mult, hidden_size) = (2, 4, 3)&lt;br&gt;即每个通道都拿到自己那份 post 缩放后的子层输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="400" y="420" width="480" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="x_gated (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="940" y="430" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n9" target="n11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n10" target="n11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n11" target="n12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="y_float = residual_mixed + x_gated&lt;br&gt;(num_tokens, hc_mult, hidden_size) = (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="940" y="560" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="y = y_float.to(bfloat16)&lt;br&gt;(num_tokens, hc_mult, hidden_size) = (2, 4, 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="940" y="700" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n5" target="n16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n12" target="n16" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" parent="1" source="n16" target="n17" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n21" value="训练/推理中 y 的精确形式：&lt;br&gt;y[b, c, h] = Σ_j comb[b, j, c] * residual[b, j, h] + post[b, c] * x[b, h]&lt;br&gt;&lt;br&gt;特例：comb = I 且 post = 1 → y = residual + x（4 条独立残差）" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="660" width="620" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
