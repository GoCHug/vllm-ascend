        <mxCell id="colA_bg" value="主链路 / Main Chain（自下而上）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#5b3a72;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="320" height="1980" as="geometry" />
        </mxCell>
        <mxCell id="colB_bg" value="张量形状 / Tensor Shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#8f3b38;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="260" height="1980" as="geometry" />
        </mxCell>
        <mxCell id="colC_bg" value="门控与混合计算 / Gate Computation（自下而上）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#3d6b34;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="860" height="1980" as="geometry" />
        </mxCell>
        <mxCell id="y_out" value="y 输出&amp;#10;(num_tokens, hidden_size)&amp;#10;(2, 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cccccc;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hc_post" value="hc_post（Attention 后混合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hc_post_note" value="residual_mixed = einsum(&#x27;b i h,b i j→b j h&#x27;, residual, comb)&amp;#10;x_gated = x.unsqueeze(1) * post.unsqueeze(-1)&amp;#10;y = (residual_mixed + x_gated).to(bfloat16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="304" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="moe" value="DeepseekV4MoE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rms1" value="RMSNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="attn" value="DeepseekV4Attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="624" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rms2" value="RMSNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="714" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="hc_pre" value="hc_pre（MoE 前混合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hc_pre_note" value="1. x_gated = x * pre_gate.unsqueeze(-1)&amp;#10;2. y_float = x_gated.sum(dim=1)&amp;#10;3. y = y_float.to(bfloat16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="864" width="240" height="68" as="geometry" />
        </mxCell>
        <mxCell id="residual_note" value="residual = hidden_states.clone()&amp;#10;unsqueeze(1).repeat(1, hc_mult, 1)&amp;#10;(num_tokens, hc_mult, hidden_size) → (2, 4, 3)&amp;#10;旁路到 hc_pre 与 hc_post 两处混合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="1090" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="x_in" value="x 输入&amp;#10;(num_tokens, hidden_size)&amp;#10;(2, 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="1930" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="branch_bg" value="三分支门控 / pre · post · comb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#a35f00;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="820" height="780" as="geometry" />
        </mxCell>
        <mxCell id="pre_gate" value="pre_gate&amp;#10;(2, 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pre_note" value="pre 门控（sigmoid + eps）&amp;#10;1. pre_tmp1 = pre_mixes * rsqrt&amp;#10;2. pre_tmp2 = pre_tmp1 * hc_scale[0]&amp;#10;3. pre_logits = pre_tmp2 + hc_base[0:hc_mult]&amp;#10;4. pre_sigmoid = sigmoid(pre_logits)&amp;#10;5. pre_gate = pre_sigmoid + hc_eps&amp;#10;shape: (num_tokens, hc_mult)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="post_gate" value="post&amp;#10;(2, 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="160" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="post_note" value="post 门控（sigmoid × 2，无 eps）&amp;#10;1. post_tmp1 = post_mixes * rsqrt&amp;#10;2. post_tmp2 = post_tmp1 * hc_scale[1]&amp;#10;3. post_logits = post_tmp2 + hc_base[hc_mult:2·hc_mult]&amp;#10;4. post_sigmoid = sigmoid(post_logits)&amp;#10;5. post = post_sigmoid * 2.0  # 放大到 (0, 2)&amp;#10;shape: (num_tokens, hc_mult)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="220" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="comb_frag" value="comb_frag&amp;#10;(2, 4, 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="comb_note" value="comb 门控（Sinkhorn 双随机归一化）&amp;#10;# 阶段1 logits + reshape&amp;#10;1. comb_tmp1 = comb_mixes * rsqrt&amp;#10;2. comb_tmp2 = comb_tmp1 * hc_scale[2]&amp;#10;3. comb_logits = comb_tmp2 + hc_base[2·hc_mult : ...+hc_mult²]&amp;#10;4. P0 = comb_logits.reshape(T, hc_mult, hc_mult)&amp;#10;# 阶段2 初始 Softmax（行归一化）&amp;#10;5. P = exp(P0 - row_max) / (row_sum + hc_eps)&amp;#10;# 阶段3 初始列归一化&amp;#10;6. P = P / (col_sum + hc_eps)&amp;#10;# 阶段4 Sinkhorn 迭代 (19 次)&amp;#10;   for t in 1..19:  行归一化 → 列归一化&amp;#10;# 阶段5 结果&amp;#10;7. comb_frag = P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1010" y="380" width="250" height="320" as="geometry" />
        </mxCell>
        <mxCell id="mixes" value="mixes = x_flat @ hc_fn.T&amp;#10;(num_tokens, mix_hc) → (2, 24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="960" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hcattn" value="hc_attn_fn  (mix_hc, hc_dim) = (24, 12)&amp;#10;hc_attn_base (mix_hc) = (24)&amp;#10;hc_attn_scale (3)&amp;#10;hc_ffn_* 结构相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="1040" width="300" height="82" as="geometry" />
        </mxCell>
        <mxCell id="rsqrt" value="rsqrt = 1 / sqrt(mean(x²) + norm_eps)&amp;#10;(num_tokens, 1) → (2, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1146" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="invrms" value="InvRMS 归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1226" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="split" value="切分 mixes（沿 mix_hc=24 维）&amp;#10;pre_mixes  (2, 4)   → [0 : 4]&amp;#10;post_mixes (2, 4)   → [4 : 8]&amp;#10;comb_mixes (2, 16)  → [8 : 24]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="1294" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="xflat" value="x_flat = x.repeat(1, hc_mult)&amp;#10;(num_tokens, hc_mult * hidden_size) → (2, 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1406" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="param_note" value="参数配置&amp;#10;hidden_size = 3   hc_mult = 4&amp;#10;hc_sinkhorn_iters = 20   hc_eps = config.hc_eps&amp;#10;mix_hc = (2 + hc_mult) * hc_mult = 24&amp;#10;hc_dim = hc_mult * hidden_size = 12&amp;#10;hc_attn_fn / hc_ffn_fn：(mix_hc, hc_dim)&amp;#10;hc_base：(mix_hc)   hc_scale：(3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="1500" width="300" height="130" as="geometry" />
