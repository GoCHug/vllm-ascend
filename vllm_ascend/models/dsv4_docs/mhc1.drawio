        <mxCell id="title" value="DeepSeek-V4 MHC 前向流程（从下往上）· 张量形状示意" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="620" height="30" as="geometry" />
